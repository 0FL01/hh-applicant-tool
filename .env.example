HH_APPLY_FORCE_MESSAGE=false
HH_APPLY_COVER_LETTER={Здравствуйте|Добрый день}, меня зовут %(first_name)s. Прошу рассмотреть мое резюме "%(resume_title)s" на вакансию "%(vacancy_name)s". С уважением, %(first_name)s.

# Исключение вакансий по ключевым словам (разделитель: запятая, точка с запятой или новая строка)
# Пример: фильтрация позиций DBA, Junior/Senior/Lead, руководителей и дежурных
HH_APPLY_EXCLUDED_KEYWORDS=Администратор баз данных,DBA,Младший,Junior,Database Administrator,Технический лидер,Дежурный,Senior,Lead,Руководитель

# Формат работы: фильтр вакансий по work_format (id из справочника HH API)
# Возможные значения: REMOTE (Удалённо), ON_SITE (На месте работодателя),
# HYBRID (Гибрид), FIELD_WORK (Разъездная), FLY_IN_FLY_OUT (Вахта)
# Можно указать несколько через запятую: REMOTE,HYBRID
# По умолчанию: REMOTE. Пустое значение отключает фильтр.
# HH_APPLY_WORK_FORMAT=REMOTE

# ==================== LLM-агент для чатов работодателей ====================

# API-ключ для OpenRouter (можно указать здесь или в config.json как openrouter.api_key)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Модель по умолчанию для агента (google/gemini-3.1-flash-lite-preview - стабильная и недорогая)
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview

# CHAT_AGENT_TEMPERATURE=0.2

# Отдельный классификатор перед генерацией ответа
# CHAT_AGENT_CLASSIFIER_ENABLED=true
# CHAT_AGENT_CLASSIFIER_MODEL=google/gemma-3-27b-it
# CHAT_AGENT_CLASSIFIER_TEMPERATURE=0
# CHAT_AGENT_CLASSIFIER_MAX_COMPLETION_TOKENS=256
# CHAT_AGENT_CLASSIFIER_REASONING=false
# CHAT_AGENT_CLASSIFIER_MAX_HISTORY_MESSAGES=8

# Webhook для кейсов recruiter_contact_offer, когда рекрутер оставляет
# внешние контакты (email, telegram, телефон) и нужно отправить context pack
# CHAT_AGENT_WEBHOOK_ENABLED=true
#
# Адрес webhook endpoint. Зависит от способа запуска:
#
#   Docker Compose (llm_agent + tg_contact_collector в одном файле):
#     Используйте Docker DNS — имя сервиса tg_contact_collector:
#     CHAT_AGENT_WEBHOOK_URL=http://tg_contact_collector:8787/webhooks/hh/recruiter-contact-offer
#
#   Локально / вне Docker:
#     CHAT_AGENT_WEBHOOK_URL=http://127.0.0.1:8787/webhooks/hh/recruiter-contact-offer
#
#   Внешний сервис:
#     CHAT_AGENT_WEBHOOK_URL=https://example.com/hooks/hh-contact
#
# CHAT_AGENT_WEBHOOK_URL=change_me
# CHAT_AGENT_WEBHOOK_TIMEOUT_SECONDS=10
# Отключите только если у webhook-хоста self-signed сертификат
# CHAT_AGENT_WEBHOOK_VERIFY_SSL=true
# Пароль/секрет для webhook, если ваш приемник его проверяет
# CHAT_AGENT_WEBHOOK_SECRET=supersecret
# CHAT_AGENT_WEBHOOK_SECRET_HEADER=X-Webhook-Secret
# CHAT_AGENT_WEBHOOK_MAX_ATTEMPTS=3
# CHAT_AGENT_WEBHOOK_RETRY_BASE_SECONDS=30

# ==================== Telegram collector для recruiter_contact_offer ====================

# Легкий HTTP-приемник, который принимает recruiter_contact_offer webhook,
# сохраняет payload в SQLite и пересылает вам уведомление через Telegram Bot API.
# Запускается командой `hh-applicant-tool tg-contact-collector` или отдельным
# сервисом `tg_contact_collector` из docker-compose.llm-agent.yml.
# TELEGRAM_COLLECTOR_BOT_TOKEN=123456:telegram-bot-token
# TELEGRAM_COLLECTOR_TARGET_CHAT_ID=123456789
# TELEGRAM_COLLECTOR_LISTEN_HOST=0.0.0.0
# Для docker-compose: listen_host внутри контейнера 0.0.0.0,
# но ports привязан к 127.0.0.1 (не светится наружу)
# TELEGRAM_COLLECTOR_LISTEN_PORT=8787
# TELEGRAM_COLLECTOR_WEBHOOK_SECRET=supersecret
# TELEGRAM_COLLECTOR_WEBHOOK_SECRET_HEADER=X-Webhook-Secret
# TELEGRAM_COLLECTOR_DB_PATH=/app/config/tg_collector.sqlite3
# TELEGRAM_COLLECTOR_TIMEOUT_SECONDS=10
# TELEGRAM_COLLECTOR_VERIFY_SSL=true
# TELEGRAM_COLLECTOR_BOT_API_BASE_URL=https://api.telegram.org

# Generic webhook endpoint: POST /webhooks/generic
# Принимает любой JSON и пересылает в Telegram.
# Шаблон сообщения задаётся через заголовок X-Telegram-Template:
#   curl -X POST http://127.0.0.1:8787/webhooks/generic \
#     -H "X-Idempotency-Key: my-unique-key" \
#     -H "X-Webhook-Secret: supersecret" \
#     -H 'X-Telegram-Template: {{title}}\n\n{{message}}' \
#     -d '{"title":"Alert","message":"Deploy done"}'
# Если шаблон не указан — отправляется JSON целиком.

# Для проверки без реальной отправки сообщений
# CHAT_AGENT_DRY_RUN=true

# Пауза между циклами daemon-режима в секундах
# CHAT_AGENT_POLL_INTERVAL=60

# Агент работает batch-циклами: после обработки новых сообщений спит случайно
# в указанном окне
# CHAT_AGENT_SLEEP_MIN_MINUTES=20
# CHAT_AGENT_SLEEP_MAX_MINUTES=30

# Таймзона и ночной quiet window (по умолчанию Москва, 23:00-08:00)
# CHAT_AGENT_TIMEZONE=Europe/Moscow
# CHAT_AGENT_QUIET_HOURS=true
# CHAT_AGENT_QUIET_HOURS_START=23:00
# CHAT_AGENT_QUIET_HOURS_END=08:00
# CHAT_AGENT_WAKE_JITTER_SECONDS=300

# Небольшое окно ожидания, чтобы склеить подряд идущие сообщения работодателя
# CHAT_AGENT_INCOMING_COLLECT_SECONDS=120

# Задержка перед первым ответом и между сообщениями Q/A-серии
# CHAT_AGENT_REPLY_DELAY_MIN_SECONDS=15
# CHAT_AGENT_REPLY_DELAY_MAX_SECONDS=60
# CHAT_AGENT_QA_SERIES_DELAY_MIN_SECONDS=30
# CHAT_AGENT_QA_SERIES_DELAY_MAX_SECONDS=120

# Лимит токенов на один ответ модели
# CHAT_AGENT_MAX_COMPLETION_TOKENS=1200

# Количество последних сообщений в чате, которые передаются модели
# CHAT_AGENT_MAX_HISTORY_MESSAGES=12

# Период в днях: игнорировать чаты, которые не обновлялись дольше указанного срока
# CHAT_AGENT_PERIOD_DAYS=14

# Пример системного промпта для агента (на русском, кратко и по делу)
CHAT_AGENT_SYSTEM_PROMPT=Ты соискатель на HeadHunter. Отвечай работодателю по-русски, вежливо, кратко и по делу. Не выдумывай факты о кандидате. Если в переписке не хватает данных, предложи уточнить детали. Не используй markdown, списки, эмодзи и канцелярит.

# Системный промпт и инструкция для классификатора
# CHAT_AGENT_CLASSIFIER_SYSTEM_PROMPT=Ты классификатор входящих сообщений в чатах hh.ru. Определи, нужно ли кандидату отвечать прямо сейчас. Отвечай только JSON без пояснений.
# CHAT_AGENT_CLASSIFIER_INSTRUCTION=Проанализируй переписку и верни JSON с полями action, category, reason, confidence. action может быть только reply или skip. category может быть только human_actionable, bot_actionable, passive_update, marketing_broadcast, recruiter_contact_offer, system_event или irrelevant. reply ставь только если в последнем неотвеченном пакете есть прямой вопрос, screening, просьба подтвердить интерес, сообщить данные или выполнить следующий шаг. recruiter_contact_offer ставь с action=skip, если рекрутер приглашает продолжить общение и оставляет внешние контакты: email, telegram, телефон, ссылку на мессенджер или другой канал связи. skip ставь для автоуведомлений, брендовых рассылок, thank-you сообщений без действия, системных событий и прочего шума. confidence - число от 0 до 1.

# Инструкция для генерации JSON-решения. Для одного ответа используйте
# reply_mode=single + reply_text. Для серии screening-ответов используйте
# reply_mode=qa_series + массив reply_messages.
CHAT_AGENT_REPLY_INSTRUCTION=Проанализируй переписку и верни JSON с полями action, reply_mode, reply_text, reply_messages, reason. action может быть только reply или skip. reply_mode может быть single или qa_series. Если нужен один цельный ответ работодателю, выбери single и заполни reply_text. Если во входящем пакете несколько screening-вопросов и естественнее ответить короткой серией, выбери qa_series и верни 2-3 коротких сообщения в reply_messages. Если отвечать не нужно, выбери skip и кратко объясни why в reason.
