HH_APPLY_FORCE_MESSAGE=false
HH_APPLY_COVER_LETTER={Здравствуйте|Добрый день}, меня зовут %(first_name)s. Прошу рассмотреть мое резюме "%(resume_title)s" на вакансию "%(vacancy_name)s". С уважением, %(first_name)s.

# Исключение вакансий по ключевым словам (разделитель: запятая, точка с запятой или новая строка)
# Пример: фильтрация позиций DBA, Junior/Senior/Lead, руководителей и дежурных
HH_APPLY_EXCLUDED_KEYWORDS=Администратор баз данных,DBA,Младший,Junior,Database Administrator,Технический лидер,Дежурный,Senior,Lead,Руководитель
